    { id: 'nutrition_logged', title: 'Macro Master', description: 'Log meals or generate nutrition plans', icon: '🥗', unlocked: true, progress: 1, maxProgress: 1 },
    { id: 'step_goal', title: 'Neural Walker', description: 'Reach 10,000 steps on sensor tracker', icon: '⚡', unlocked: false, progress: 6420, maxProgress: 10000 },
  ]);

  useEffect(() => {
    if (typeof window !== 'undefined') {
      localStorage.setItem('aura_auraPoints', JSON.stringify(auraPoints));
      localStorage.setItem('aura_userAvatarIcon', JSON.stringify(userAvatarIcon));
      localStorage.setItem('aura_userAvatarBg', JSON.stringify(userAvatarBg));
    }
  }, [auraPoints, userAvatarIcon, userAvatarBg]);

  const addCaloriesBurned = (cals: number) => {
    setCaloriesBurned(prev => prev + cals);
  };

  const checkAchievements = (actionId: string) => {
    setAchievements(prev => prev.map(ach => {
      if (ach.id === actionId && !ach.unlocked) {
        const nextProg = ach.progress + 1;
        if (nextProg >= ach.maxProgress) {
          setAuraPoints(p => p + 150);
          return { ...ach, progress: ach.maxProgress, unlocked: true };
        }
        return { ...ach, progress: nextProg };
      }
      return ach;
    }));
  };

  return (
    <main className="min-h-screen bg-slate-950 text-slate-100 flex flex-col items-center justify-start pb-28 selection:bg-emerald-500 selection:text-slate-950 font-sans relative overflow-hidden">
      
      {/* Background Ambient Glows */}
      <div className="absolute top-0 left-1/2 -translate-x-1/2 w-[500px] h-[300px] bg-emerald-500/5 blur-[120px] pointer-events-none rounded-full" />
      <div className="absolute bottom-10 right-0 w-[400px] h-[300px] bg-teal-500/5 blur-[120px] pointer-events-none rounded-full" />

      <header className="w-full max-w-md px-5 pt-6 pb-4 flex items-center justify-between border-b border-slate-900/80 sticky top-0 bg-slate-950/80 backdrop-blur-xl z-30 shadow-sm">
        <div className="flex items-center gap-3">
          <div className={`w-12 h-12 rounded-2xl flex items-center justify-center text-xl font-black shadow-lg shadow-emerald-500/20 ${userAvatarBg}`}>
            {userAvatarIcon}
          </div>
          <div>
            <div className="flex items-center gap-1.5">
              <span className="text-[10px] font-extrabold uppercase tracking-widest text-emerald-400">AURA-22</span>
              <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            </div>
            <h1 className="text-sm font-black text-slate-100 tracking-tight">Neural Fitness Core</h1>
          </div>
        </div>

        <div className="flex items-center gap-2">
          <button 
            onClick={() => setBluetoothConnected(!bluetoothConnected)}
            className={`px-3 py-2 rounded-2xl border transition flex items-center gap-1.5 text-[10px] font-black uppercase tracking-wider shadow-sm ${bluetoothConnected ? 'bg-emerald-500/10 border-emerald-500/40 text-emerald-400 shadow-emerald-500/10' : 'bg-slate-900 border-slate-800 text-slate-400 hover:text-slate-200'}`}
          >
            <Bluetooth className="w-3.5 h-3.5" />
            <span>{bluetoothConnected ? 'SYNCED' : 'PAIR'}</span>
          </button>
        </div>
      </header>

      <div className="w-full max-w-md px-5 pt-4">
        <div className="p-3.5 rounded-2xl bg-slate-900/70 border border-slate-800/80 backdrop-blur-md flex items-center justify-between text-xs shadow-inner">
          <div className="flex items-center gap-2.5">
            <Activity className="w-4 h-4 text-emerald-400 animate-pulse" />
            <span className="font-extrabold text-slate-200 tracking-tight">{stepCount.toLocaleString()} <span className="text-[10px] text-slate-400 font-semibold uppercase">Steps</span></span>
          </div>
          <div className="flex items-center gap-3">
            <span className="text-slate-400 font-bold">{heartRate} <span className="text-[10px] font-semibold uppercase">BPM</span></span>
            <span className="text-emerald-400 font-black tracking-tight">{caloriesBurned} <span className="text-[10px] font-semibold uppercase">Cals</span></span>
          </div>
        </div>
      </div>

      <div className="w-full max-w-md px-5 pt-4 flex-1">
        {activeTab === 'explore' && (
          <ExploreTab 
            customRoutines={customRoutines}
            setCustomRoutines={setCustomRoutines}
            workoutDays={workoutDays}
            setWorkoutDays={setWorkoutDays}
            fitnessGoal={fitnessGoal}
            setFitnessGoal={setFitnessGoal}
            energyLevel={energyLevel}
            setEnergyLevel={setEnergyLevel}
            addCaloriesBurned={addCaloriesBurned}
            auraPoints={auraPoints}
            setAuraPoints={setAuraPoints}
            checkAchievements={checkAchievements}
            userSex={userSex}
            lifeStage={lifeStage}
            trackCycle={trackCycle}
            currentCyclePhase={currentCyclePhase}
            neuralRecoveryScore={neuralRecoveryScore}
            strainBudget={strainBudget}
            setStrainBudget={setStrainBudget}
          />
        )}

        {activeTab === 'nutrition' && (
          <NutritionTab 
            planDays={planDays}
            setPlanDays={setPlanDays}
            consumedCaloriesToday={consumedCaloriesToday}
            setConsumedCaloriesToday={setConsumedCaloriesToday}
            loggedItems={loggedItems}
            setLoggedItems={setLoggedItems}
            setAuraPoints={setAuraPoints}
            checkAchievements={checkAchievements}
            userSex={userSex}
            lifeStage={lifeStage}
            waterGlasses={waterGlasses}
            setWaterGlasses={setWaterGlasses}
          />
        )}

        {activeTab === 'leaderboard' && (
          <LeaderboardTab 
            auraPoints={auraPoints}
            achievements={achievements}
          />
        )}

        {activeTab === 'profile' && (
          <ProfileTab 
            userAvatarIcon={userAvatarIcon}
            setUserAvatarIcon={setUserAvatarIcon}
            userAvatarBg={userAvatarBg}
            setUserAvatarBg={setUserAvatarBg}
            auraPoints={auraPoints}
            streakShields={streakShields}
            setStreakShields={setStreakShields}
          />
        )}
      </div>

      {/* Floating Pill Navigation */}
      <nav className="fixed bottom-4 left-0 right-0 max-w-sm mx-auto p-1.5 bg-slate-950/90 backdrop-blur-2xl border border-slate-800/90 z-40 flex justify-around items-center rounded-3xl shadow-2xl">
        {[
          { id: 'explore', label: 'Explore', icon: Compass },
          { id: 'nutrition', label: 'Nutrition', icon: Utensils },
          { id: 'leaderboard', label: 'Rankings', icon: Trophy },
          { id: 'profile', label: 'Profile', icon: User },
        ].map(tab => {
          const Icon = tab.icon;
          const isActive = activeTab === tab.id;
          return (
            <button
              key={tab.id}
              onClick={() => setActiveTab(tab.id as any)}
              className={`flex items-center gap-2 py-2 px-3.5 rounded-2xl transition-all duration-300 ${isActive ? 'text-slate-950 bg-emerald-400 shadow-md shadow-emerald-400/25 font-black scale-105' : 'text-slate-400 hover:text-slate-200 font-bold'}`}
            >
              <Icon className={`w-4 h-4 ${isActive ? 'stroke-[2.5]' : 'stroke-2'}`} />
              <span className={`text-[11px] uppercase tracking-wider ${isActive ? 'inline-block' : 'hidden sm:inline-block'}`}>{tab.label}</span>
            </button>
          );
        })}
      </nav>

    </main>
  );
}
