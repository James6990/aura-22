'use client';
import { useState, useEffect } from 'react';
import { Compass, Utensils, User, Zap, Bookmark, Sparkles, Activity, Bluetooth, Download, CheckCircle2, Trophy, Award, Sliders, Calculator, Droplet, ShieldCheck, RefreshCw, Trash2, ArrowRight } from 'lucide-react';

// --- TYPES ---
interface CustomRoutineItem {
  day: number;
  focus: string;
  intensity: string;
  aiRecommendedTime: string;
  completed?: boolean;
}

interface LoggedItem {
  id: string;
  name: string;
  calories: number;
}

interface LeaderboardUser {
  rank: number;
  name: string;
  auraPoints: number;
  league: 'Active' | 'Novice' | 'Challenger' | 'Prodigy' | 'Elite' | 'Legend';
  avatarIcon: string;
  avatarBg: string;
  isUser?: boolean;
}

interface Achievement {
  id: string;
  title: string;
  description: string;
  icon: string;
  unlocked: boolean;
  progress: number;
  maxProgress: number;
}

// --- TAB 1: EXPLORE VIEW (AI Workout Customizer, Strain Budget & Recovery) ---
function ExploreTab({ 
  customRoutines, 
  setCustomRoutines, 
  workoutDays, 
  setWorkoutDays, 
  fitnessGoal, 
  setFitnessGoal,
  energyLevel,
  setEnergyLevel,
  addCaloriesBurned,
  auraPoints,
  setAuraPoints,
  checkAchievements,
  userSex,
  lifeStage,
  trackCycle,
  currentCyclePhase,
  neuralRecoveryScore,
  strainBudget,
  setStrainBudget
}: {
  customRoutines: CustomRoutineItem[];
  setCustomRoutines: React.Dispatch<React.SetStateAction<CustomRoutineItem[]>>;
  workoutDays: number;
  setWorkoutDays: (days: number) => void;
  fitnessGoal: 'hypertrophy' | 'endurance' | 'mobility';
  setFitnessGoal: (goal: 'hypertrophy' | 'endurance' | 'mobility') => void;
  energyLevel: number;
  setEnergyLevel: (level: number) => void;
  addCaloriesBurned: (cals: number) => void;
  auraPoints: number;
  setAuraPoints: React.Dispatch<React.SetStateAction<number>>;
  checkAchievements: (action: string) => void;
  userSex: 'female' | 'male';
  lifeStage: 'standard' | 'perimenopause' | 'postmenopause';
  trackCycle: boolean;
  currentCyclePhase: 'follicular' | 'ovulation' | 'luteal' | 'menstruation';
  neuralRecoveryScore: number;
  strainBudget: number;
  setStrainBudget: React.Dispatch<React.SetStateAction<number>>;
}) {
  const [bookmarks, setBookmarks] = useState<string[]>([]);
  const [isSynthesizing, setIsSynthesizing] = useState(false);
  const [progressionLevel, setProgressionLevel] = useState(1);

  const WORKOUTS = [
    { id: '1', title: '15-Min Core & Glow Flow', category: 'Quick Burn', energy: 'High Vibe', duration: '15m', color: 'from-emerald-950/40 via-slate-900 to-slate-950', cals: 180 },
    { id: '2', title: 'Full Body Vibe Sculpt', category: 'Strength', energy: 'Power', duration: '30m', color: 'from-blue-950/40 via-slate-900 to-slate-950', cals: 320 },
  ];

  const handleGenerateCustomProgram = () => {
    setIsSynthesizing(true);
    setTimeout(() => {
      const generated: CustomRoutineItem[] = [];
      let baseFocus = ['Upper Body Power', 'Core Activation & Stability', 'Lower Body Hypertrophy', 'Neural Recovery & Vibe Flow'];
      
      let bioMod = '';
      if (neuralRecoveryScore < 60) {
        baseFocus = ['Active Mobility Flow', 'Deep Breathing & CNS Reset', 'Gentle Stretch & Vibe', 'Restorative Restoration'];
        bioMod = ' [Neural Recovery Override]';
      } else if (userSex === 'female' && (lifeStage === 'perimenopause' || lifeStage === 'postmenopause')) {
        bioMod = ' [Bone-Loading Protocol]';
      } else if (userSex === 'female' && trackCycle) {
        if (currentCyclePhase === 'follicular' || currentCyclePhase === 'ovulation') {
          bioMod = ' [Peak Estrogen Window]';
        } else {
          bioMod = ' [Energy-Matched Flow]';
        }
      }

      for (let i = 1; i <= workoutDays; i++) {
        let loadModifier = neuralRecoveryScore < 60 ? 'Recovery Flow (Low Impact)' : fitnessGoal === 'hypertrophy' ? `High Load (Lv.${progressionLevel})${bioMod}` : `Metabolic Circuit (Lv.${progressionLevel})${bioMod}`;
        if (progressionLevel > 1 && neuralRecoveryScore >= 60) {
          loadModifier += ' + Progressive Overload';
        }

        generated.push({
          day: i,
          focus: baseFocus[(i - 1) % baseFocus.length],
          intensity: loadModifier,
          aiRecommendedTime: i % 2 === 0 ? '07:30 AM' : '05:30 PM',
          completed: false,
        });
      }
      setCustomRoutines(generated);
      setIsSynthesizing(false);
      setAuraPoints(p => p + 100);
      checkAchievements('program_created');
    }, 400);
  };

  const toggleBookmark = (id: string) => {
    setBookmarks(prev => prev.includes(id) ? prev.filter(i => i !== id) : [...prev, id]);
  };

  const toggleCompleteRoutine = (dayNum: number) => {
    setCustomRoutines(prev => prev.map(item => {
      if (item.day === dayNum) {
        const nextState = !item.completed;
        if (nextState) {
          addCaloriesBurned(250); 
          setProgressionLevel(p => p + 0.1);
          setAuraPoints(p => p + 50);
          setStrainBudget(prevStrain => Math.min(100, prevStrain + 20));
          checkAchievements('workout_completed');
        }
        return { ...item, completed: nextState };
      }
      return item;
    }));
  };

  const exportSchedulePDF = () => {
    const content = `AURA-22 CUSTOM ${workoutDays}-DAY PROGRAM\nGoal: ${fitnessGoal.toUpperCase()} | Life Stage: ${lifeStage.toUpperCase()}\n\n` +
      customRoutines.map(r => `Day ${r.day} [${r.aiRecommendedTime}] - ${r.focus} (${r.intensity})`).join('\n');
    
    const blob = new Blob([content], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `Aura22_Workout_Plan_${workoutDays}Days.txt`;
    a.click();
    URL.revokeObjectURL(url);
  };

  return (
    <div className="space-y-6 animate-fadeIn pb-6">
      {/* Recovery & Strain Budget Card */}
      <div className="p-6 rounded-[2rem] bg-slate-900/90 border border-slate-800/80 shadow-2xl backdrop-blur-xl relative overflow-hidden space-y-5">
        <div className="absolute -right-10 -top-10 w-32 h-32 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none" />
        <div className="flex items-center justify-between">
          <span className="text-[11px] font-extrabold uppercase tracking-widest text-emerald-400 flex items-center gap-1.5">
            <RefreshCw className="w-4 h-4 animate-spin" /> CNS Neural Recovery & Strain
          </span>
          <span className={`text-[10px] font-bold px-3 py-1 rounded-full ${neuralRecoveryScore >= 70 ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 shadow-sm shadow-emerald-500/20' : 'bg-amber-500/10 text-amber-400 border border-amber-500/30'}`}>
            {neuralRecoveryScore >= 70 ? 'Optimal Readiness' : 'Rest Advised'}
          </span>
        </div>

        <div className="grid grid-cols-2 gap-4">
          <div className="p-4 rounded-2xl bg-slate-950/70 border border-slate-800/60 shadow-inner">
            <span className="text-[10px] font-bold uppercase text-slate-400 block mb-1">Recovery Score</span>
            <span className="text-2xl font-black text-emerald-400 tracking-tight">{neuralRecoveryScore}%</span>
            <span className="text-[10px] text-slate-500 font-medium block mt-0.5">Optimal Readiness</span>
          </div>
          <div className="p-4 rounded-2xl bg-slate-950/70 border border-slate-800/60 shadow-inner">
            <span className="text-[10px] font-bold uppercase text-slate-400 block mb-1">Strain Budget</span>
            <span className="text-2xl font-black text-amber-400 tracking-tight">{strainBudget}%</span>
            <span className="text-[10px] text-slate-500 font-medium block mt-0.5">Daily Load Used</span>
          </div>
        </div>

        <div className="space-y-2">
          <div className="flex justify-between text-[11px] text-slate-400 font-semibold uppercase tracking-wider">
            <span>Adaptive Factor ({progressionLevel.toFixed(1)}x)</span>
            <span className="text-emerald-400">{energyLevel}% Battery</span>
          </div>
          <input 
            type="range" min="20" max="100" value={energyLevel} 
            onChange={(e) => setEnergyLevel(Number(e.target.value))}
            className="w-full accent-emerald-400 bg-slate-800 rounded-lg h-2 cursor-pointer transition"
          />
        </div>
      </div>

      <div className="p-6 rounded-[2rem] bg-slate-900/90 border border-slate-800/80 shadow-2xl backdrop-blur-xl space-y-5">
        <div className="flex justify-between items-start">
          <div>
            <span className="text-[11px] font-extrabold uppercase tracking-widest text-emerald-400 flex items-center gap-1.5">
              <Sliders className="w-4 h-4" /> Bio-Adaptive Routine Architect
            </span>
            <h2 className="text-xl font-black text-slate-100 mt-1 tracking-tight">Custom Multi-Day Program</h2>
            <p className="text-xs text-slate-400 mt-0.5">Calibrated for {userSex} physiology ({lifeStage}).</p>
          </div>
          {customRoutines.length > 0 && (
            <button onClick={exportSchedulePDF} className="px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-800 text-emerald-400 hover:border-emerald-500 transition flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider shadow-sm">
              <Download className="w-3.5 h-3.5" /> Export
            </button>
          )}
        </div>

        <div className="space-y-4">
          <div>
            <label className="text-[11px] font-extrabold uppercase text-slate-400 mb-2 flex justify-between tracking-wider">
              <span>Program Schedule Length</span>
              <span className="text-emerald-400 font-black">{workoutDays} Days</span>
            </label>
            <input 
              type="range" min="7" max="90" value={workoutDays} 
              onChange={e => setWorkoutDays(Number(e.target.value))}
              className="w-full accent-emerald-400 bg-slate-800 rounded-lg h-2 cursor-pointer transition"
            />
          </div>

          <div>
            <label className="text-[11px] font-extrabold uppercase text-slate-400 mb-2 block tracking-wider">Optimization Goal</label>
            <div className="grid grid-cols-3 gap-2">
              {(['hypertrophy', 'endurance', 'mobility'] as const).map(g => (
                <button key={g} onClick={() => setFitnessGoal(g)} className={`py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider border transition ${fitnessGoal === g ? 'bg-emerald-500 text-slate-950 border-emerald-400 shadow-md shadow-emerald-500/20 font-black' : 'bg-slate-950/70 text-slate-400 border-slate-800/80 hover:border-slate-700'}`}>
                  {g}
                </button>
              ))}
            </div>
          </div>

          <button onClick={handleGenerateCustomProgram} disabled={isSynthesizing} className="w-full py-3.5 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-400 text-slate-950 font-black text-xs uppercase tracking-widest shadow-lg shadow-emerald-500/25 hover:opacity-95 transition flex items-center justify-center gap-2">
            {isSynthesizing ? 'Synthesizing Custom Program...' : `Launch ${workoutDays}-Day Custom Program`} <ArrowRight className="w-4 h-4" />
          </button>
        </div>

        {customRoutines.length > 0 && (
          <div className="space-y-2.5 pt-2 max-h-72 overflow-y-auto pr-1">
            <span className="text-[11px] font-extrabold uppercase tracking-wider text-emerald-400 block mb-1">Optimized Schedule (Tap to Complete)</span>
            {customRoutines.map(item => (
              <div 
                key={item.day} 
                onClick={() => toggleCompleteRoutine(item.day)}
                className={`p-4 rounded-2xl border flex items-center justify-between cursor-pointer transition group ${item.completed ? 'bg-emerald-950/20 border-emerald-500/50 shadow-sm' : 'bg-slate-950/70 border-slate-800/80 hover:border-slate-700'}`}
              >
                <div>
                  <span className={`text-[10px] font-extrabold uppercase tracking-wider ${item.completed ? 'text-emerald-300' : 'text-emerald-400'}`}>
                    Day {item.day} • {item.aiRecommendedTime}
                  </span>
                  <p className={`text-xs font-bold mt-0.5 ${item.completed ? 'line-through text-slate-500' : 'text-slate-100 group-hover:text-emerald-300 transition'}`}>{item.focus}</p>
                </div>
                <div className="flex items-center gap-2.5">
                  <span className="px-2.5 py-1 rounded-lg bg-slate-900 text-[10px] text-slate-400 border border-slate-800 font-medium">{item.intensity}</span>
                  {item.completed && <CheckCircle2 className="w-4 h-4 text-emerald-400" />}
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <div className="space-y-3.5">
        <h2 className="text-xs font-extrabold uppercase tracking-wider text-slate-400 flex items-center gap-1.5 px-1">
          <Sparkles className="w-4 h-4 text-emerald-400" /> Curated Workouts
        </h2>
        {WORKOUTS.map(item => (
          <div key={item.id} className={`rounded-[2rem] p-6 bg-gradient-to-br ${item.color} border border-slate-800/80 shadow-xl transition hover:border-slate-700`}>
            <div className="flex items-center justify-between mb-3">
              <span className="px-3 py-1 rounded-xl text-[10px] font-black uppercase tracking-wider bg-slate-900/90 text-emerald-300 border border-slate-800 shadow-sm">
                {item.category}
              </span>
              <button 
                onClick={() => toggleBookmark(item.id)}
                className={`p-2.5 rounded-2xl border transition ${bookmarks.includes(item.id) ? 'bg-emerald-500 text-slate-950 border-emerald-400 shadow-sm shadow-emerald-500/20' : 'bg-slate-900 text-slate-400 border-slate-800 hover:text-slate-200'}`}
              >
                <Bookmark className="w-4 h-4 fill-current" />
              </button>
            </div>
            <span className="text-[11px] uppercase font-bold text-emerald-400 tracking-wider block mb-1">{item.energy} • {item.duration}</span>
            <h3 className="text-lg font-black text-slate-100 tracking-tight">{item.title}</h3>
          </div>
        ))}
      </div>
    </div>
  );
}

// --- TAB 2: AI NUTRITION, QUICK MACRO JUMP & HYDRATION ---
function NutritionTab({
  planDays,
  setPlanDays,
  consumedCaloriesToday,
  setConsumedCaloriesToday,
  loggedItems,
  setLoggedItems,
  setAuraPoints,
  checkAchievements,
  userSex,
  lifeStage,
  waterGlasses,
  setWaterGlasses
}: {
  planDays: number;
  setPlanDays: (days: number) => void;
  consumedCaloriesToday: number;
  setConsumedCaloriesToday: React.Dispatch<React.SetStateAction<number>>;
  loggedItems: LoggedItem[];
  setLoggedItems: React.Dispatch<React.SetStateAction<LoggedItem[]>>;
  setAuraPoints: React.Dispatch<React.SetStateAction<number>>;
  checkAchievements: (action: string) => void;
  userSex: 'female' | 'male';
  lifeStage: 'standard' | 'perimenopause' | 'postmenopause';
  waterGlasses: number;
  setWaterGlasses: React.Dispatch<React.SetStateAction<number>>;
}) {
  const [height, setHeight] = useState('175');
  const [weight, setWeight] = useState('70');
  const [goal, setGoal] = useState<'cut' | 'maintain' | 'bulk'>('cut');
  const [activity, setActivity] = useState<'light' | 'moderate' | 'heavy'>('moderate');
  const [dietPreference, setDietPreference] = useState<'omnivore' | 'vegetarian' | 'vegan' | 'gluten-free' | 'keto'>('omnivore');
  const [plan, setPlan] = useState<any>(null);
  const [loading, setLoading] = useState(false);

  const [customFoodName, setCustomFoodName] = useState('');
  const [customFoodCals, setCustomFoodCals] = useState('');

  const generatePlan = () => {
    setLoading(true);
    setTimeout(() => {
      const w = parseFloat(weight) || 70;
      const h = parseFloat(height) || 175;
      
      let c = 10 * w + 6.25 * h - 25 * 25 + (userSex === 'male' ? 5 : -161);
      c *= activity === 'light' ? 1.2 : activity === 'moderate' ? 1.55 : 1.75;
      
      if (goal === 'cut') c -= 500;
      if (goal === 'bulk') c += 400;

      if (userSex === 'female' && (lifeStage === 'perimenopause' || lifeStage === 'postmenopause')) {
        c -= 150;
      }

      let mealPool = [
        'Matcha Protein Cloud Bowl & Almond Toast',
        'Wild Salmon Quinoa Power Greens',
        'Tofu Cashew Stir-fry with Brown Rice',
        'Greek Yogurt Berry & Chia Crunch',
        'Lean Steak & Sweet Potato Mash',
        'Avocado Egg White Cloud Wrap',
        'Clean Fuel Iron-Rich Recovery Smoothie'
      ];

      if (dietPreference === 'vegetarian') {
        mealPool = [
          'Greek Yogurt Berry & Chia Crunch',
          'Tofu Cashew Stir-fry with Brown Rice',
          'Spinach Halloumi Quinoa Bowl',
          'Lentil & Sweet Potato Power Curry',
          'Avocado Egg White Cloud Wrap',
          'Peanut Butter Banana Protein Oats',
          'Mediterranean Chickpea Salad Wrap'
        ];
      } else if (dietPreference === 'vegan') {
        mealPool = [
          'Plant Protein Acai Vibe Bowl with Chia',
          'Tofu Cashew Stir-fry with Brown Rice',
          'Lentil & Sweet Potato Power Curry',
          'Almond Butter Banana Flaxseed Oats',
          'Roasted Chickpea & Quinoa Greens Bowl',
          'Vegan Hemp Seed Recovery Smoothie',
          'Black Bean & Avocado Buddha Bowl'
        ];
      } else if (dietPreference === 'gluten-free') {
        mealPool = [
          'Wild Salmon Quinoa Power Greens',
          'Greek Yogurt Berry & Chia Crunch',
          'Lean Steak & Sweet Potato Mash',
          'Avocado Egg White Cloud Wrap (GF Tortilla)',
          'Clean Fuel Iron-Rich Recovery Smoothie',
          'Grilled Chicken & Roasted Root Vegetables',
          'Chia Seed Coconut Milk Pudding with Berries'
        ];
      } else if (dietPreference === 'keto') {
        mealPool = [
          'Avocado & Bacon Egg White Frittata',
          'Wild Salmon with Butter-Garlic Asparagus',
          'Ribeye Steak & Steamed Broccoli Macadamia',
          'MCT Oil Keto Green Protein Shake',
          'Grilled Chicken Caesar Salad (No Croutons)',
          'Baked Salmon with Spinach and Olive Oil',
          'Macadamia Nut & Cheese Crunch Bowl'
        ];
      }

      const customMenu = [];
      for (let i = 1; i <= planDays; i++) {
        customMenu.push({
          day: i,
          meal: mealPool[(i - 1) % mealPool.length],
          aiTime: i % 2 === 0 ? '12:30 PM (Peak Metabolic Window)' : '08:00 AM (Morning Fuel)',
          calories: Math.round(c + ((i % 3) * 20 - 30))
        });
      }

      setPlan({
        targetCalories: Math.round(c),
        protein: Math.round(w * 2.2),
        schedule: customMenu
      });
      setLoading(false);
      setAuraPoints(p => p + 75);
      checkAchievements('nutrition_logged');
    }, 400);
  };

  const logMealItem = (name: string, cals: number) => {
    setLoggedItems(prev => [...prev, { id: Date.now().toString(), name, calories: cals }]);
    setConsumedCaloriesToday(prev => prev + cals);
    setAuraPoints(p => p + 25);
    checkAchievements('nutrition_logged');
  };

  const handleAddCustomFood = (e: React.FormEvent) => {
    e.preventDefault();
    const cals = parseInt(customFoodCals);
    if (!customFoodName || isNaN(cals)) return;
    logMealItem(customFoodName, cals);
    setCustomFoodName('');
    setCustomFoodCals('');
  };

  const removeLoggedItem = (id: string, cals: number) => {
    setLoggedItems(prev => prev.filter(item => item.id !== id));
    setConsumedCaloriesToday(prev => Math.max(0, prev - cals));
  };

  const exportNutritionPDF = () => {
    if (!plan) return;
    const content = `AURA-22 NUTRITION BLUEPRINT (${planDays} DAYS)\nDiet: ${dietPreference.toUpperCase()} | Target Calories: ${plan.targetCalories} kcal | Protein: ${plan.protein}g\n\n` +
      plan.schedule.map((d: any) => `Day ${d.day} [${d.aiTime}] - ${d.meal} (${d.calories} kcal)`).join('\n');
    
    const blob = new Blob([content], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `Aura22_Nutrition_Plan_${planDays}Days.txt`;
    a.click();
    URL.revokeObjectURL(url);
  };

  const targetCals = plan ? plan.targetCalories : 2000;
  const remainingCals = targetCals - consumedCaloriesToday;

  return (
    <div className="space-y-6 animate-fadeIn pb-6">
      {/* Hydration Tracker Widget */}
      <div className="p-6 rounded-[2rem] bg-slate-900/90 border border-slate-800/80 shadow-2xl backdrop-blur-xl space-y-4">
        <div className="flex items-center justify-between">
          <span className="text-[11px] font-extrabold uppercase tracking-widest text-emerald-400 flex items-center gap-1.5">
            <Droplet className="w-4 h-4" /> Circadian Hydration Balance
          </span>
          <span className="text-[11px] font-black text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-full border border-emerald-500/30">{waterGlasses} / 8 Glasses</span>
        </div>
        <div className="flex gap-2 justify-between">
          {Array.from({ length: 8 }).map((_, idx) => {
            const isFilled = idx < waterGlasses;
            return (
              <button
                key={idx}
                onClick={() => {
                  const nextVal = idx + 1 === waterGlasses ? waterGlasses - 1 : idx + 1;
                  setWaterGlasses(nextVal);
                  if (nextVal > waterGlasses) setAuraPoints(p => p + 5);
                }}
                className={`flex-1 h-12 rounded-2xl border flex items-center justify-center transition ${isFilled ? 'bg-emerald-500 border-emerald-400 text-slate-950 shadow-md shadow-emerald-500/20' : 'bg-slate-950/70 border-slate-800/80 text-slate-600 hover:text-slate-400'}`}
              >
                <Droplet className={`w-4 h-4 ${isFilled ? 'fill-current' : ''}`} />
              </button>
            );
          })}
        </div>
      </div>

      <div className="p-6 rounded-[2rem] bg-slate-900/90 border border-slate-800/80 shadow-2xl backdrop-blur-xl space-y-5">
        <div className="flex items-center justify-between">
          <div>
            <span className="text-[11px] font-extrabold uppercase tracking-widest text-emerald-400 flex items-center gap-1.5">
              <Calculator className="w-4 h-4" /> Live Calorie Deficit
            </span>
            <h2 className="text-xl font-black text-slate-100 mt-1 tracking-tight">Energy Balance</h2>
          </div>
          <span className={`px-3 py-1 rounded-full text-[11px] font-extrabold border ${remainingCals >= 0 ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30 shadow-sm shadow-emerald-500/10' : 'bg-rose-500/10 text-rose-400 border-rose-500/30'}`}>
            {remainingCals >= 0 ? `${remainingCals} kcal Left` : `${Math.abs(remainingCals)} kcal Over`}
          </span>
        </div>

        <div className="grid grid-cols-3 gap-3 text-center">
          <div className="p-4 rounded-2xl bg-slate-950/70 border border-slate-800/60 shadow-inner">
            <span className="text-[10px] font-bold uppercase text-slate-400 block mb-1">Target</span>
            <span className="text-lg font-black text-slate-100 tracking-tight">{targetCals}</span>
            <span className="text-[10px] text-slate-500 font-medium block mt-0.5">kcal</span>
          </div>
          <div className="p-4 rounded-2xl bg-slate-950/70 border border-slate-800/60 shadow-inner">
            <span className="text-[10px] font-bold uppercase text-slate-400 block mb-1">Consumed</span>
            <span className="text-lg font-black text-emerald-400 tracking-tight">{consumedCaloriesToday}</span>
            <span className="text-[10px] text-slate-500 font-medium block mt-0.5">kcal</span>
          </div>
          <div className="p-4 rounded-2xl bg-slate-950/70 border border-slate-800/60 shadow-inner">
